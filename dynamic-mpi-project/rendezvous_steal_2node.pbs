#!/bin/bash
#PBS -N rendezvous_steal_2node
#PBS -q workq
#PBS -l nodes=2:ppn=4
#PBS -l walltime=00:15:00
#PBS -j oe

# ==============================================================================
# Two-node verification of the rendezvous layer (8 ranks, 4 per node):
#   1. rendezvous_steal_test  - Stage 3 STEAL (ChunkTaskEngine)
#   2. rendezvous_layer_test  - Stage 2 GET regression
# Each node runs its own node-local shared-memory channel/engine/layer.
#
# Error handling is explicit (no `set -e`): every step is checked, both tests
# always run, each test's real exit code is printed, and the job exits
# nonzero if anything failed. The final success message is printed only if
# both tests pass.
# ==============================================================================

PROJECT_DIR=/home/student4/BT2024199/Project/dynamic-mpi/dynamic-mpi-project
NP=8
PPN=4

die() {
    echo "ERROR: $1"
    echo "===== JOB FAILED (exit code $2) ====="
    exit "$2"
}

echo "========== TWO-NODE RENDEZVOUS STEAL TEST =========="
date

cd "$PROJECT_DIR" || die "cannot cd to $PROJECT_DIR" 1

echo "===== JOB DETAILS ====="
echo "Job ID:    ${PBS_JOBID:-<not set>}"
echo "Job name:  ${PBS_JOBNAME:-<not set>}"
echo "Node file: ${PBS_NODEFILE:-<not set>}"
echo "Directory: $(pwd)"

if [ -z "${PBS_NODEFILE:-}" ] || [ ! -r "$PBS_NODEFILE" ]; then
    die "PBS_NODEFILE is not set or not readable (submit with qsub)" 1
fi

echo "===== ALLOCATED NODES ====="
sort "$PBS_NODEFILE" | uniq -c

HOST_COUNT=$(sort -u "$PBS_NODEFILE" | wc -l)
SLOT_COUNT=$(wc -l < "$PBS_NODEFILE")
echo "Hosts: $HOST_COUNT  Slots: $SLOT_COUNT"

if [ "$HOST_COUNT" -ne 2 ]; then
    die "Expected 2 nodes, got $HOST_COUNT" 1
fi
if [ "$SLOT_COUNT" -lt "$NP" ]; then
    die "Expected at least $NP slots, got $SLOT_COUNT" 1
fi

echo "===== ENVIRONMENT ====="
module load intel-2018 || die "module load intel-2018 failed" 1
echo "mpicxx: $(command -v mpicxx)"
echo "mpirun: $(command -v mpirun)"
mpicxx --version 2>&1 | head -n 1
mpirun --version 2>&1 | head -n 1

# Fresh build for this job: removes build/ (objects, .d dependency files and
# binaries) so no stale artifact from an earlier build is reused.
echo "========== CLEAN BUILD =========="
make clean || exit 1

echo "========== REBUILDING TEST BINARIES =========="
make rendezvous_steal_test rendezvous_layer_test || exit 1

run_test() {
    # $1 = label, $2 = binary under ./build
    echo
    echo "===== RUNNING $1: mpirun -np $NP -ppn $PPN -f \$PBS_NODEFILE ./build/$2 ====="
    mpirun -np "$NP" -ppn "$PPN" -f "$PBS_NODEFILE" "./build/$2"
    local rc=$?
    echo "===== $1 EXIT CODE: $rc ====="
    return "$rc"
}

STEAL_RC=0
run_test "STAGE 3 STEAL" rendezvous_steal_test || STEAL_RC=$?

GET_RC=0
run_test "STAGE 2 GET REGRESSION" rendezvous_layer_test || GET_RC=$?

echo
echo "===== SUMMARY ====="
echo "rendezvous_steal_test exit code: $STEAL_RC"
echo "rendezvous_layer_test exit code: $GET_RC"
date

if [ "$STEAL_RC" -ne 0 ]; then
    die "rendezvous_steal_test failed" "$STEAL_RC"
fi
if [ "$GET_RC" -ne 0 ]; then
    die "rendezvous_layer_test failed" "$GET_RC"
fi

echo "===== ALL TWO-NODE TESTS PASSED ====="
exit 0
