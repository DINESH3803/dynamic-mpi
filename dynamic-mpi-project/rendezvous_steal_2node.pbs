#PBS -l nodes=2:ppn=4
#PBS -l walltime=00:15:00
#PBS -j oe

echo "========== TWO-NODE STEAL VERIFICATION =========="

cd /home/student4/BT2024199/Project/dynamic-mpi/dynamic-mpi-project || exit 1

echo "========== JOB DETAILS =========="
echo "Job ID: $PBS_JOBID"
echo "Node file: $PBS_NODEFILE"

echo "========== ALLOCATED NODES =========="
sort "$PBS_NODEFILE" | uniq -c

HOST_COUNT=$(sort -u "$PBS_NODEFILE" | wc -l)

if [ "$HOST_COUNT" -ne 2 ]; then
    echo "ERROR: Expected 2 nodes, got $HOST_COUNT"
    exit 1
fi

module load intel-2018

echo "========== COMPILER =========="
which mpicxx
mpicxx --version

echo "========== COMPILING =========="
make rendezvous_steal_test rendezvous_layer_test || exit 1

echo "========== TWO-NODE NORMAL STEAL TEST =========="
mpirun -np 8 -ppn 4 -f "$PBS_NODEFILE" ./build/rendezvous_steal_test
STEAL_RESULT=$?

echo "STEAL TEST EXIT CODE: $STEAL_RESULT"

if [ "$STEAL_RESULT" -ne 0 ]; then
    echo "ERROR: Two-node STEAL test failed"
    exit "$STEAL_RESULT"
fi

echo "========== TWO-NODE STAGE 2 REGRESSION =========="
mpirun -np 8 -ppn 4 -f "$PBS_NODEFILE" ./build/rendezvous_layer_test
GET_RESULT=$?

echo "STAGE 2 TEST EXIT CODE: $GET_RESULT"

if [ "$GET_RESULT" -ne 0 ]; then
    echo "ERROR: Stage 2 regression failed"
    exit "$GET_RESULT"
fi

echo "========== TWO-NODE VERIFICATION PASSED =========="

exit 0
