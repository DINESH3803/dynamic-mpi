 -N rendezvous_steal_2node
#PBS -q workq
#PBS -l nodes=2:ppn=4
#PBS -l walltime=00:15:00
#PBS -j oe

# ============================================================
# Two-node verification:
#   1. Stage 3 STEAL protocol
#   2. Stage 2 GET regression
#
# Allocation: 2 nodes, 4 MPI ranks per node (8 total)
# Build directory is outside the project because PBS executes
# as student3 while the project belongs to student4.
# ============================================================

PROJECT_DIR="/home/student4/BT2024199/Project/dynamic-mpi/dynamic-mpi-project"
BUILD_DIR="/home/student4/.pbs_route/output/dynamic_mpi_build"

NP=8
PPN=4

die() {
    echo "ERROR: $1"
    echo "========== JOB FAILED (exit code $2) =========="
    exit "$2"
}

echo "========== TWO-NODE STEAL VERIFICATION =========="
date

# ------------------------------------------------------------
# Enter project directory
# ------------------------------------------------------------

cd "$PROJECT_DIR" || die "Cannot enter project directory" 1

echo "========== JOB DETAILS =========="
echo "Job ID: ${PBS_JOBID:-unknown}"
echo "Project directory: $(pwd)"
echo "Build directory: $BUILD_DIR"
echo "Node file: ${PBS_NODEFILE:-not set}"

# ------------------------------------------------------------
# Validate PBS allocation
# ------------------------------------------------------------

if [ -z "${PBS_NODEFILE:-}" ] || [ ! -f "$PBS_NODEFILE" ]; then
    die "PBS_NODEFILE is missing or invalid" 1
fi

echo "Allocated hosts:"
sort "$PBS_NODEFILE" | uniq -c

HOST_COUNT=$(sort -u "$PBS_NODEFILE" | wc -l)
SLOT_COUNT=$(wc -l < "$PBS_NODEFILE")

echo "Unique nodes: $HOST_COUNT"
echo "Total slots: $SLOT_COUNT"

if [ "$HOST_COUNT" -ne 2 ]; then
    die "Expected exactly 2 allocated nodes" 1
fi

if [ "$SLOT_COUNT" -lt "$NP" ]; then
    die "Expected at least $NP MPI slots" 1
fi

# ------------------------------------------------------------
# Load Intel toolchain
# ------------------------------------------------------------

echo "========== LOADING INTEL TOOLCHAIN =========="

module load intel-2018 || die "Failed to load intel-2018 module" 1

echo "mpicxx path:"
which mpicxx || die "mpicxx not found" 1

echo "mpirun path:"
which mpirun || die "mpirun not found" 1

echo "========== COMPILER VERSION =========="
mpicxx --version

# ------------------------------------------------------------
# Validate external build directory
# ------------------------------------------------------------

echo "========== PREPARING BUILD DIRECTORY =========="

mkdir -p "$BUILD_DIR" || die "Cannot create build directory" 2

if [ ! -w "$BUILD_DIR" ]; then
    die "Build directory is not writable by PBS execution user" 2
fi

echo "Build directory permissions:"
ls -ld "$BUILD_DIR"

# ------------------------------------------------------------
# Clean build
# ------------------------------------------------------------

echo "========== CLEAN BUILD =========="

make BUILD_DIR="$BUILD_DIR" clean || die "make clean failed" 2

echo "========== COMPILING TEST TARGETS =========="

make BUILD_DIR="$BUILD_DIR" rendezvous_steal_test rendezvous_layer_test \
    || die "Compilation failed" 2

if [ ! -x "$BUILD_DIR/rendezvous_steal_test" ]; then
    die "STEAL test binary was not created" 2
fi

if [ ! -x "$BUILD_DIR/rendezvous_layer_test" ]; then
    die "GET regression test binary was not created" 2
fi

echo "========== BUILD SUCCESSFUL =========="

ls -lh "$BUILD_DIR/rendezvous_steal_test" \
       "$BUILD_DIR/rendezvous_layer_test"

# ------------------------------------------------------------
# Run Stage 3 STEAL tests
# ------------------------------------------------------------

echo "========== RUNNING TWO-NODE STEAL TESTS =========="

STEAL_RC=0

mpirun -np "$NP" -ppn "$PPN" -f "$PBS_NODEFILE" \
    "$BUILD_DIR/rendezvous_steal_test"

STEAL_RC=$?

echo "STEAL test exit code: $STEAL_RC"

# ------------------------------------------------------------
# Run Stage 2 GET regression tests
# ------------------------------------------------------------

echo "========== RUNNING TWO-NODE GET REGRESSION =========="

GET_RC=0

mpirun -np "$NP" -ppn "$PPN" -f "$PBS_NODEFILE" \
    "$BUILD_DIR/rendezvous_layer_test"

GET_RC=$?

echo "GET regression exit code: $GET_RC"

# ------------------------------------------------------------
# Final result
# ------------------------------------------------------------

echo "========== TWO-NODE VERIFICATION SUMMARY =========="
echo "STEAL test exit code: $STEAL_RC"
echo "GET regression exit code: $GET_RC"

if [ "$STEAL_RC" -ne 0 ] || [ "$GET_RC" -ne 0 ]; then
    die "One or more two-node tests failed" 3
fi

echo "========== TWO-NODE VERIFICATION PASSED =========="
date

exit 0

#!/bin/bash
#PBS -N rendezvous_steal_2node
#PBS -q workq
#PBS -l nodes=2:ppn=4
#PBS -l walltime=00:15:00
#PBS -j oe

# ============================================================
# Two-node verification:
#   1. Stage 3 STEAL protocol
#   2. Stage 2 GET regression
#
# Allocation: 2 nodes, 4 MPI ranks per node (8 total)
# ============================================================

PROJECT_DIR="/home/student4/BT2024199/Project/dynamic-mpi/dynamic-mpi-project"
NP=8
PPN=4

die() {
    echo "ERROR: $1"
    echo "========== JOB FAILED (exit code $2) =========="
    exit "$2"
}

echo "========== TWO-NODE STEAL VERIFICATION =========="
date

# ------------------------------------------------------------
# Enter project directory
# ------------------------------------------------------------

cd "$PROJECT_DIR" || die "Cannot enter project directory" 1

echo "========== JOB DETAILS =========="
echo "Job ID: ${PBS_JOBID:-unknown}"
echo "Project directory: $(pwd)"
echo "Node file: ${PBS_NODEFILE:-not set}"

# ------------------------------------------------------------
# Validate PBS allocation
# ------------------------------------------------------------

if [ -z "${PBS_NODEFILE:-}" ] || [ ! -f "$PBS_NODEFILE" ]; then
    die "PBS_NODEFILE is missing or invalid" 1
fi

echo "Allocated hosts:"
sort "$PBS_NODEFILE" | uniq -c

HOST_COUNT=$(sort -u "$PBS_NODEFILE" | wc -l)
SLOT_COUNT=$(wc -l < "$PBS_NODEFILE")

echo "Unique nodes: $HOST_COUNT"
echo "Total slots: $SLOT_COUNT"

if [ "$HOST_COUNT" -ne 2 ]; then
    die "Expected exactly 2 allocated nodes" 1
fi

if [ "$SLOT_COUNT" -lt "$NP" ]; then
    die "Expected at least $NP MPI slots" 1
fi

# ------------------------------------------------------------
# Load cluster toolchain
# ------------------------------------------------------------

echo "========== LOADING INTEL TOOLCHAIN =========="

module load intel-2018 || die "Failed to load intel-2018 module" 1

echo "mpicxx path:"
which mpicxx || die "mpicxx not found" 1

echo "mpirun path:"
which mpirun || die "mpirun not found" 1

echo "========== COMPILER VERSION =========="
mpicxx --version

# ------------------------------------------------------------
# Clean build
# ------------------------------------------------------------

echo "========== CLEAN BUILD =========="

make clean || die "make clean failed" 2

echo "========== COMPILING TEST TARGETS =========="

make rendezvous_steal_test rendezvous_layer_test || die "Compilation failed" 2

if [ ! -x build/rendezvous_steal_test ]; then
    die "STEAL test binary was not created" 2
fi

if [ ! -x build/rendezvous_layer_test ]; then
    die "GET regression test binary was not created" 2
fi

echo "========== BUILD SUCCESSFUL =========="
ls -lh build/rendezvous_steal_test build/rendezvous_layer_test

# ------------------------------------------------------------
# Run Stage 3 STEAL tests
# ------------------------------------------------------------

echo "========== RUNNING TWO-NODE STEAL TESTS =========="

STEAL_RC=0

mpirun -np "$NP" -ppn "$PPN" -f "$PBS_NODEFILE" \
    ./build/rendezvous_steal_test

STEAL_RC=$?

echo "STEAL test exit code: $STEAL_RC"

# ------------------------------------------------------------
# Run Stage 2 GET regression tests
# ------------------------------------------------------------

echo "========== RUNNING TWO-NODE GET REGRESSION =========="

GET_RC=0

mpirun -np "$NP" -ppn "$PPN" -f "$PBS_NODEFILE" \
    ./build/rendezvous_layer_test

GET_RC=$?

echo "GET regression exit code: $GET_RC"

# ------------------------------------------------------------
# Final result
# ------------------------------------------------------------

echo "========== TWO-NODE VERIFICATION SUMMARY =========="
echo "STEAL test exit code: $STEAL_RC"
echo "GET regression exit code: $GET_RC"

if [ "$STEAL_RC" -ne 0 ] || [ "$GET_RC" -ne 0 ]; then
    die "One or more two-node tests failed" 3
fi

echo "========== TWO-NODE VERIFICATION PASSED =========="
date

exit 0


