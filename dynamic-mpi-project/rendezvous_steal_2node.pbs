#PBS -l walltime=00:15:00
#PBS -j oe

# ============================================================
# Two-node verification:
#   1. Stage 3 STEAL protocol
#   2. Stage 2 GET regression
#
# Allocation: 2 nodes, 4 MPI ranks per node (8 total)
# ============================================================

PROJECT_DIR="/home/student4/BT2024199/Project/dynamic-mpi/dynamic-mpi-project"
NP=8
PPN=4

die() {
    echo "ERROR: $1"
    echo "========== JOB FAILED (exit code $2) =========="
    exit "$2"
}

echo "========== TWO-NODE STEAL VERIFICATION =========="
date

# ------------------------------------------------------------
# Enter project directory
# ------------------------------------------------------------

cd "$PROJECT_DIR" || die "Cannot enter project directory" 1

echo "========== JOB DETAILS =========="
echo "Job ID: ${PBS_JOBID:-unknown}"
echo "Job name: ${PBS_JOBNAME:-unknown}"
echo "Node file: ${PBS_NODEFILE:-unknown}"
echo "Project directory: $(pwd)"

# ------------------------------------------------------------
# Validate PBS allocation
# ------------------------------------------------------------

if [ -z "${PBS_NODEFILE:-}" ] || [ ! -r "$PBS_NODEFILE" ]; then
    die "PBS_NODEFILE is missing or unreadable" 1
fi

echo "========== ALLOCATED NODES =========="
sort "$PBS_NODEFILE" | uniq -c

HOST_COUNT=$(sort -u "$PBS_NODEFILE" | wc -l)
SLOT_COUNT=$(wc -l < "$PBS_NODEFILE")

echo "Number of nodes: $HOST_COUNT"
echo "Total MPI slots: $SLOT_COUNT"

if [ "$HOST_COUNT" -ne 2 ]; then
    die "Expected 2 nodes, found $HOST_COUNT" 1
fi

if [ "$SLOT_COUNT" -lt "$NP" ]; then
    die "Expected at least $NP MPI slots, found $SLOT_COUNT" 1
fi

# ------------------------------------------------------------
# Load MPI environment
# ------------------------------------------------------------

echo "========== MPI ENVIRONMENT =========="

module load intel-2018 || die "Failed to load intel-2018 module" 1

echo "mpicxx path:"
which mpicxx

echo "mpicxx version:"
mpicxx --version

echo "mpirun path:"
which mpirun

echo "mpirun version:"
mpirun --version

# ------------------------------------------------------------
# Clean build
# ------------------------------------------------------------

echo "========== CLEAN BUILD =========="

make clean || die "make clean failed" 1

echo "========== REBUILDING TEST BINARIES =========="

make rendezvous_steal_test rendezvous_layer_test 
    || die "Compilation failed" 2

echo "========== BUILD SUCCESSFUL =========="

# ------------------------------------------------------------
# Test execution helper
# ------------------------------------------------------------

run_test() {
    local label="$1"
    local binary="$2"

    echo
    echo "========== RUNNING $label =========="
    echo "Command: mpirun -np $NP -ppn $PPN -f $PBS_NODEFILE ./build/$binary"

    mpirun -np "$NP" -ppn "$PPN" -f "$PBS_NODEFILE" "./build/$binary"

    local result=$?

    echo "========== $label EXIT CODE: $result =========="

    return "$result"
}

# ------------------------------------------------------------
# Stage 3: STEAL protocol
# ------------------------------------------------------------

STEAL_RESULT=0

run_test "STAGE 3 STEAL TEST" rendezvous_steal_test 
    || STEAL_RESULT=$?

# ------------------------------------------------------------
# Stage 2: GET regression
# Run even if the STEAL test fails, to retain regression results.
# ------------------------------------------------------------

GET_RESULT=0

run_test "STAGE 2 GET REGRESSION" rendezvous_layer_test 
    || GET_RESULT=$?

# ------------------------------------------------------------
# Final summary
# ------------------------------------------------------------

echo
echo "========== TWO-NODE VERIFICATION SUMMARY =========="

echo "STEAL test exit code: $STEAL_RESULT"
echo "GET regression exit code: $GET_RESULT"

date

if [ "$STEAL_RESULT" -ne 0 ]; then
    die "Stage 3 STEAL test failed" "$STEAL_RESULT"
fi

if [ "$GET_RESULT" -ne 0 ]; then
    die "Stage 2 GET regression failed" "$GET_RESULT"
fi

echo
echo "========== ALL TWO-NODE TESTS PASSED =========="

exit 0
 -N rendezvous_steal_2node
